# Postgres port
POSTGRES_PORT=5432

# Postgres DB name
POSTGRES_DB=changeme

# Postgres DB username
POSTGRES_USER=changeme

# Postgres DB password
POSTGRES_PASSWORD=changeme

# Minio URL

MINIO_URL = http://localhost
# Minio Bucket Name

MINIO_BUCKET = back

# Minio port
MINIO_PORT=9000

# Minio access key
MINIO_ROOT_USER=changeme

# Minio secret key
MINIO_ROOT_PASSWORD=changeme

# Application port
APPLICATION_PORT=8080

#JWT secret for application
JWT_SECRET=changeme

#JWT token expiration time for application
JWT_EXPIRATION_TIME_IN_SECONDS=3600

#JWT issuer
JWT_ISSUER=app

