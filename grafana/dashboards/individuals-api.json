{
  "id": null,
  "uid": "individuals-api",
  "title": "Individuals API",
  "description": "Auth & Keycloak metrics for individuals-api",
  "tags": ["individuals-api", "spring-boot"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Auth — Registrations",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Registrations — Success",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area", "orientation": "auto" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "green" }, "unit": "short" }
      },
      "targets": [
        {
          "expr": "increase(auth_registrations_total{status=\"success\"}[1h])",
          "legendFormat": "Success",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Registrations — Errors",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area", "orientation": "auto" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "red" }, "unit": "short" }
      },
      "targets": [
        {
          "expr": "increase(auth_registrations_total{status!=\"success\"}[1h])",
          "legendFormat": "Errors",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Registration Success Rate",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "orientation": "auto" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.8 },
              { "color": "green", "value": 0.95 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        {
          "expr": "rate(auth_registrations_total{status=\"success\"}[5m]) / rate(auth_registrations_total[5m])",
          "legendFormat": "Success rate",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Registration Rate by Status",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 10 } }
      },
      "targets": [
        {
          "expr": "rate(auth_registrations_total{status=\"success\"}[1m])",
          "legendFormat": "success",
          "refId": "A"
        },
        {
          "expr": "rate(auth_registrations_total{status=\"validation_error\"}[1m])",
          "legendFormat": "validation_error",
          "refId": "B"
        },
        {
          "expr": "rate(auth_registrations_total{status=\"user_already_exists\"}[1m])",
          "legendFormat": "user_already_exists",
          "refId": "C"
        },
        {
          "expr": "rate(auth_registrations_total{status=\"keycloak_error\"}[1m])",
          "legendFormat": "keycloak_error",
          "refId": "D"
        },
        {
          "expr": "rate(auth_registrations_total{status=\"error\"}[1m])",
          "legendFormat": "error",
          "refId": "E"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Registration p50 Latency",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(auth_registration_duration_seconds_bucket[5m]))",
          "legendFormat": "p50",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Registration p95 Latency",
