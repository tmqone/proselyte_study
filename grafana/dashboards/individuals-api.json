      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(auth_registration_duration_seconds_bucket[5m]))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Registration p99 Latency",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
